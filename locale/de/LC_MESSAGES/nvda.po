#. Translators: Question after a failed login. {platform} = brand name.
#: settings_panel.py:1722
msgid ""
"The {platform} login was refused.\n"
"\n"
"Enter the credentials again?"
msgstr ""
"Die Anmeldung bei {platform} wurde abgelehnt.\n"
"\n"
"Zugangsdaten erneut eingeben?"

#. Translators: Title of the dialog after a failed login. {platform} = brand
#. name.
#: settings_panel.py:1726
msgid "{platform} login failed"
msgstr "Anmeldung bei {platform} fehlgeschlagen"

#. Translators: Login error with the platform's own message. {platform} =
#. brand name, {error} = message from the platform.
#: settings_panel.py:67
msgid "{platform} login failed: {error}"
msgstr "Anmeldung bei {platform} fehlgeschlagen: {error}"

#. Translators: Login error for wrong credentials. {platform} = brand name
#. (Meross etc.). The library's own English message is replaced here, since it
#. is not translatable.
#: settings_panel.py:58
msgid "{platform}: email address or password not accepted"
msgstr "{platform}: E-Mail-Adresse oder Passwort nicht akzeptiert"

#. Translators: Announcement after a refused credential check. {reason} = why
#. the platform refused, e.g. "Meross: email address or password not
#. accepted".
#: settings_panel.py:1559
msgid "{reason}. Nothing saved - please enter the credentials again"
msgstr "{reason}. Nichts gespeichert - Zugangsdaten bitte erneut eingeben"

#. Translators: Status while one platform is being checked. {platform} = brand
#. name (Meross etc.).
#: settings_panel.py:1488
msgid "Checking {platform}..."
msgstr "{platform} wird geprüft..."
