#. Translators: Remaining cooking time of an air fryer, under a minute.
#. {seconds} = seconds.
#: vesync_devices.py:1578
msgid "{seconds} sec"
msgstr "{seconds} Sek."

#. Translators: Temperature an air fryer was set to, as opposed to the one it
#. currently measures. {value} = number with unit.
#: dialog_vesync.py:1048
