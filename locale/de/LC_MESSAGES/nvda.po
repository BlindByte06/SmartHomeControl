msgstr "Solltemperatur: {value}"

#. Translators: Remaining cooking time of an air fryer, whole minutes.
#. {minutes} = minutes.
#: vesync_devices.py:1568
msgid "{minutes} min"
msgstr "{minutes} Min."

#. Translators: Action entry in the device tree, stops a running cooking
#. programme.
#: dialog_vesync.py:1093
msgid "Stop programme - Enter"
msgstr "Programm beenden - Enter"

#. Translators: Title of the dialog that stops a cooking programme.
#: dialog_vesync.py:749
msgid "Stop programme"
msgstr "Programm beenden"

#. Translators: Safety prompt before a cooking programme is stopped. {name} =
#. device name, {programme} = programme name, {remaining} = remaining time.
#: dialog_vesync.py:731
msgid ""
"Stop the programme {programme} on {name}?\n"
"\n"
"{remaining} still to run."
msgstr ""
"Programm {programme} auf {name} beenden?\n"
"\n"
"Es laufen noch {remaining}."

#. Translators: Safety prompt before a cooking programme is stopped, with no
#. remaining time known. {name} = device name, {programme} = programme name.
#: dialog_vesync.py:738
msgid "Stop the programme {programme} on {name}?"
msgstr "Programm {programme} auf {name} beenden?"

#. Translators: Safety prompt before a cooking programme is stopped. {name} =
#. device name.
#: dialog_vesync.py:743
msgid "Stop the running programme on {name}?"
msgstr "Laufendes Programm auf {name} beenden?"

#. Translators: Button labels of the prompt before stopping a cooking
#. programme.
#: dialog_vesync.py:754
msgid "&Yes, stop"
msgstr "&Ja, beenden"

#. Translators: Confirmation after a cooking programme was stopped. {name} =
#. device name.
#: dialog_vesync.py:774
msgid "{name}: programme stopped"
msgstr "{name}: Programm beendet"

#. Translators: Error when a running cooking programme could not be stopped.
#: vesync_devices.py:2048
msgid "VeSync: the programme could not be stopped"
msgstr "VeSync: Das Programm konnte nicht beendet werden"

#. Translators: History entry: a cooking programme was stopped from the add-
#. on.
#: history.py:1192
msgid "Cooking programme stopped"
msgstr "Garprogramm beendet"

#. Translators: Action entry in the device tree, starts a cooking programme.
#: dialog_vesync.py:1077
msgid "Start programme - Enter"
msgstr "Programm starten - Enter"

#. Translators: Title of the dialog that starts a cooking programme.
#: dialog_vesync.py:551 dialog_vesync.py:456
msgid "Start programme"
msgstr "Programm starten"

#. Translators: Prompt of the programme list. {count} = how many programmes
#. the appliance has shown so far.
#: dialog_vesync.py:450
msgid "Which programme? The appliance has reported {count} so far."
msgstr "Welches Programm? Das Gerät hat bisher {count} gemeldet."

#. Translators: Message when a cooking programme is to be started but the
#. appliance has not reported one yet.
#: dialog_vesync.py:442
msgid ""
"No programme has been reported by this appliance yet. Selecting one on the "
"appliance itself teaches it to the add-on."
msgstr ""
"Dieses Gerät hat noch kein Programm gemeldet. Ein am Gerät gewähltes "
"Programm wird dem Add-on dadurch bekannt."

#. Translators: Title of the cooking time entry.
#: dialog_vesync.py:505 dialog_vesync.py:648
msgid "Cooking time"
msgstr "Garzeit"

#. Translators: Prompt of the temperature entry. {low}/{high} = the permitted
#. values.
#: dialog_vesync.py:495 dialog_vesync.py:627
msgid "Temperature between {low} and {high}:"
msgstr "Temperatur zwischen {low} und {high}:"

#. Translators: Prompt of the cooking time entry. {low}/{high} = the permitted
#. values in minutes.
#: dialog_vesync.py:508 dialog_vesync.py:651
msgid "Time in minutes, between {low} and {high}:"
msgstr "Zeit in Minuten, zwischen {low} und {high}:"

#. Translators: Message after an entry outside the permitted range.
#. {low}/{high} = the permitted values.
#: dialog_vesync.py:414
msgid "Please enter a whole number between {low} and {high}"
msgstr "Bitte eine ganze Zahl zwischen {low} und {high} eingeben"

#. Translators: Button labels of the prompt before starting a cooking
#. programme, when the settings can still be changed.
#: dialog_vesync.py:559 dialog_vesync.py:564
msgid "&Yes, start"
msgstr "&Ja, starten"

#. Translators: Error when a cooking programme could not be started.
#: vesync_devices.py:1898
msgid "VeSync: the programme could not be started"
msgstr "VeSync: Das Programm konnte nicht gestartet werden"

#. Translators: Error when a temperature outside the appliance's range was
#. entered. {low}/{high} = the permitted values.
#: vesync_devices.py:1837 vesync_devices.py:1975
msgid "The temperature has to be between {low} and {high}"
msgstr "Die Temperatur muss zwischen {low} und {high} liegen"

#. Translators: Error when a cooking time outside the permitted range was
#. entered. {low}/{high} = the permitted values in minutes.
#: vesync_devices.py:1844 vesync_devices.py:1984
msgid "The time has to be between {low} and {high} minutes"
msgstr "Die Zeit muss zwischen {low} und {high} Minuten liegen"

#. Translators: Tree entry for an air fryer that has not reported its state
#. yet.
#: dialog_vesync.py:1118
msgid "Waiting for the appliance"
msgstr "Warten auf das Gerät"

#. Translators: History entry: a cooking programme was started from the add-
#. on.
#: history.py:1195
msgid "Cooking programme started"
msgstr "Garprogramm gestartet"

#. Translators: Context help for the tree entry that stops a cooking
#. programme.
#: dialog_help.py:284
msgid ""
"Stop the running cooking programme of the air fryer. Enter asks for "
"confirmation first."
msgstr ""
"Beendet das laufende Garprogramm der Heißluftfritteuse. Enter fragt zuerst "
"nach."

#. Translators: Question before a cooking programme is started, with the
#. programme, the appliance, the temperature and the time.
#: dialog_vesync.py:545
msgid ""
"Start {programme} on {name}?\n"
"\n"
"{temperature} for {minutes} minutes."
msgstr ""
"{programme} auf {name} starten?\n"
"\n"
"{temperature} für {minutes} Minuten."

#. Translators: Confirmation after a cooking programme was sent to the
#. appliance. {name} = device name, {programme} = programme name.
#: dialog_vesync.py:598
msgid "{name}: {programme} set"
msgstr "{name}: {programme} eingestellt"

#. Translators: Action entry in the device tree, changes the time of a loaded
#. cooking programme.
#: dialog_vesync.py:1085
msgid "Change cooking time - Enter"
msgstr "Garzeit ändern - Enter"

#. Translators: Title of the dialog that changes the time or temperature of a
#. running cooking programme.
#: dialog_vesync.py:678
msgid "Change programme"
msgstr "Programm ändern"

#. Translators: Safety prompt before the temperature of a running programme is
#. changed. {name} = device name, {temperature} = new set temperature with
#. unit.
#: dialog_vesync.py:638
msgid "Change the temperature on {name} to {temperature}?"
msgstr "Temperatur auf {name} auf {temperature} ändern?"

#. Translators: Safety prompt before the time of a running programme is
#. changed. {name} = device name, {minutes} = new time in minutes.
#. Deliberately "set to" rather than "add": the value sent becomes the new
#. remaining time, measured twice - it replaces what was left, it is not added
#. to it.
#: dialog_vesync.py:667
msgid "Set the cooking time on {name} to {minutes} minutes?"
msgstr "Garzeit auf {name} auf {minutes} Minuten setzen?"

#. Translators: Button labels of the prompt before the time or temperature of
#. a running programme is changed.
#: dialog_vesync.py:683
msgid "&Yes, change"
msgstr "&Ja, ändern"

#. Translators: Button labels of the prompt before starting a cooking
#. programme, when the settings can still be changed.
#: dialog_vesync.py:559
msgid "C&hange..."
msgstr "Ä&ndern ..."

#. Translators: Confirmation after the time or temperature of a running
#. programme was changed. {name} = device name.
#: dialog_vesync.py:703
msgid "{name}: change sent"
msgstr "{name}: Änderung gesendet"

#. Translators: Error when the time or temperature of a running programme
#. could not be changed.
#: vesync_devices.py:2018
msgid "VeSync: the change was not accepted"
msgstr "VeSync: Die Änderung wurde nicht angenommen"

#. Translators: History entry: time or temperature of a running cooking
#. programme was changed.
#: history.py:1198
msgid "Cooking programme adjusted"
msgstr "Garprogramm angepasst"

#. Translators: How long the selected cooking programme will take, before it
#. has started running. {value} = time, e.g. "6 min".
#: dialog_vesync.py:1031
msgid "Duration: {value}"
msgstr "Dauer: {value}"

#. Translators: An air fryer whose programme is paused and can go on.
#: constants.py:157
msgid "paused"
msgstr "Pausiert"

#. Translators: Label of the input field for how long a favorites layer digit
#. may still be pressed a second time to switch.
#: settings_panel.py:421
msgid "Favorites layer: &switching press valid for (seconds):"
msgstr "Favoriten-Ebene: &Schaltdruck gültig für (Sekunden):"

#. Translators: Accessible name of the favorites switch window field in the
#. General tab of the settings.
#: settings_panel.py:428
msgid "Favorites layer switching window in seconds"
msgstr "Schaltfenster der Favoriten-Ebene in Sekunden"

#. Translators: Tooltip for the favorites layer switching window.
#: settings_panel.py:431
msgid ""
"In the favorites layer a digit announces the status, and the same digit "
"pressed again switches the device. This is how long after the announcement "
"that second press still switches. Later presses announce the status again "
"instead, so a digit pressed by accident long afterwards cannot switch "
"anything off. Between {low} and {high}, default {default}."
msgstr ""
"In der Favoriten-Ebene sagt eine Ziffer den Status an, dieselbe Ziffer "
"erneut schaltet das Gerät. So lange nach der Ansage schaltet dieser zweite "
"Druck noch. Späteres Drücken sagt stattdessen wieder den Status an, damit "
"eine viel später versehentlich gedrückte Ziffer nichts abschalten kann. "
"Zwischen {low} und {high}, Standard {default}."

#. Translators: Announce the cooking state of an air fryer (started, paused,
#. finished).
#: settings_panel.py:981
msgid "Announce the cooking state of air fryers (running / paused / finished)"
msgstr ""
"Kochzustand von Heißluftfritteusen ansagen (läuft / pausiert / fertig)"

#. Translators: Announcement when a cooking programme has finished.
#: constants.py:184
msgid "Programme finished"
msgstr "Programm fertig"

#. Translators: Announcement when a cooking programme was paused at the
#. appliance.
#: constants.py:182
msgid "Programme paused"
msgstr "Programm pausiert"

#. Translators: Announcement when an air fryer has started cooking.
#: constants.py:179
msgid "Programme running"
msgstr "Garen läuft"

#. Translators: An air fryer accepted a temperature change and did not carry
#. it out. {value} = the temperature the appliance is still set to, with its
#. unit.
#: change_detection.py:621
msgid "Temperature not applied, the appliance stays at {value}"
msgstr "Temperatur nicht übernommen, das Gerät bleibt bei {value}"

#. Translators: Tree entry for an air fryer, in place of a control for the
#. temperature. The appliance accepts no temperature while cooking.
#: dialog_vesync.py:1068
msgid ""
"Temperature only settable when starting the programme, or at the appliance"
msgstr "Temperatur nur beim Programmstart oder am Gerät einstellbar"

#. Translators: Context help for the tree entry that changes the time of a
#. loaded cooking programme. The temperature is deliberately not mentioned as
#. changeable: the appliance does not accept one while it cooks.
#: dialog_help.py:303
msgid ""
"Change the cooking time of the loaded programme. Enter asks for the new "
"value and confirms it before sending. The remaining time line then shows "
"what the appliance made of it. The temperature cannot be changed while the "
"appliance cooks - only when a programme is started, or at the appliance."
msgstr ""
"Die Garzeit des geladenen Programms ändern. Enter fragt den neuen Wert ab "
"und bestätigt ihn vor dem Senden. Die Zeile mit der Restzeit zeigt danach, "
"was das Gerät daraus gemacht hat. Die Temperatur lässt sich während des "
"Garens nicht ändern – nur beim Start eines Programms oder am Gerät."

#. Translators: Context help for the tree entry that starts a cooking
#. programme.
#: dialog_help.py:289
msgid ""
"Start a cooking programme. Enter offers the programmes this appliance has "
"reported. Temperature and time can be adjusted on the way, and everything is"
" confirmed before it is sent. Cosori appliances may require their own start "
"button to be pressed afterwards; the programme state then says “ready to "
"start” instead of “cooking”."
msgstr ""
"Ein Garprogramm starten. Enter bietet die Programme an, die dieses Gerät "
"gemeldet hat. Temperatur und Zeit lassen sich dabei anpassen, und alles wird"
" vor dem Senden bestätigt. Bei Cosori-Geräten muss danach unter Umständen "
"die Taste am Gerät gedrückt werden; der Programmzustand sagt dann "
"„Startbereit“ statt „Garen läuft“."

#. Translators: Tree entry for an air fryer whose programme is loaded but not
#. yet running.
#: dialog_vesync.py:1106
msgid "The cooking time can only be changed once the programme runs"
msgstr "Die Garzeit lässt sich erst ändern, wenn das Programm läuft"

#. Translators: Error when a cooking programme is missing the identifier the
#. appliance needs to start it.
#: vesync_devices.py:1863
msgid "VeSync: this programme has no identifier and cannot be started"
msgstr ""
"VeSync: Dieses Programm hat keine Kennung und lässt sich nicht starten"

#. Translators: Master switch in the notifications tab.
#: settings_panel.py:858
msgid ""
"&Announce external changes at all (Alexa, the manufacturer app, a switch on "
"the device)"
msgstr ""
"&Externe Änderungen überhaupt ansagen (Alexa, Hersteller-App, Schalter am "
"Gerät)"

#. Translators: Accessible name of the explanatory text at the top of a
#. settings tab.
#: settings_panel.py:340
msgid "Notes"
msgstr "Hinweise"

#. Translators: Tooltip explanation of the external changes checkbox.
#: settings_panel.py:865
msgid ""
"Off, and nothing below is announced, whichever platform it belongs to. On, "
"and the settings below decide what is worth hearing."
msgstr ""
"Ausgeschaltet wird nichts von dem angesagt, was darunter steht, gleich "
"welcher Plattform es gehört. Eingeschaltet entscheiden die Einstellungen "
"darunter, was zu hören ist."

#. Translators: Explanatory text in the Netatmo tab. Mentions dev.netatmo.com.
#: settings_panel.py:571
msgid ""
"Netatmo OAuth2 credentials.\n"
"Create an app at https://dev.netatmo.com and enter the client ID and secret here.\n"
"The app also needs a redirect URI, and it has to match exactly:\n"
"http://localhost:PORT/callback, with PORT the number set below.\n"
"The manual explains it under \"Netatmo: redirect URI and port\"."
msgstr ""
"Netatmo-OAuth2-Zugangsdaten.\n"
"Auf https://dev.netatmo.com eine App anlegen und Client-ID und Client-Secret hier eintragen.\n"
"Die App braucht außerdem eine Redirect-URI, und die muss genau übereinstimmen:\n"
"http://localhost:PORT/callback, mit dem Port aus dem Feld weiter unten.\n"
"Das Handbuch erklärt das unter „Netatmo: Redirect-URI und Port\"."

#. Translators: Label in front of the explanatory text at the top of a
#. settings tab.
#: settings_panel.py:333
msgid "Notes:"
msgstr "Hinweise:"

#. Translators: Description of the add-on in the add-on store.
#: manifest.ini:description
msgid ""
"Control smart home devices (Meross, Netatmo, VeSync, Cozytouch/Atlantic - "
"Cozytouch experimental) directly from NVDA"
msgstr ""
"Smart-Home-Geräte (Meross, Netatmo, VeSync, Cozytouch/Atlantic - Cozytouch "
"experimentell) direkt aus NVDA steuern"

#. Translators: Spoken when the shortcut for the device menu is pressed while
#. the menu is already open.
#: __init__.py:1106
msgid "Device menu is already open"
msgstr "Gerätemenü ist bereits geöffnet"

#. Translators: History entry: the duration of the boost was set.
#: history.py:1172
msgid "Boost duration set"
msgstr "Boost-Dauer gesetzt"

