#. appliance. {name} = device name, {programme} = programme name.
#: dialog_vesync.py:598
msgid "{name}: {programme} set"
msgstr ""

#. Translators: Announcement of an external switch state change.
#: __init__.py:2293 __init__.py:2238 __init__.py:2252 device_dialog.py:1328
#: dialog_vesync.py:44 dialog_vesync.py:201
msgid "{name}: {status}"
msgstr ""

#. Translators: One line per hub sensor. {name} = sensor name, {status} =
#. Online/Offline, {type} = model (e.g. MS130), {battery} = battery text.
#: device_dialog.py:1966
msgid "{name}: {status}, {type}, {battery}"
msgstr ""

#. Translators: Short live announcement of the device online status.
#: device_dialog.py:1889
msgid "{online} devices online, {offline} offline"
msgstr ""

#. Translators: Format of the status line. {online}/{offline} = counts, {time}
#. = time of the last refresh in HH:MM:SS format.
#: device_dialog.py:1879
msgid "{online} online, {offline} offline | Updated: {time}"
msgstr ""

#. Translators: One piece of the device help spoken with F1. The pieces are
#. joined with ". ", so no full stop at the end.
#: dialog_help.py:658
msgid "{on} of {total} channels switched on"
msgstr ""

#. Translators: Note that a platform was enabled automatically after a
#. successful test. {platform} = brand name (Meross etc.).
#: settings_panel.py:500
msgid "{platform} enabled – login will happen on save"
msgstr ""

#. Translators: Title of the dialog after a failed login. {platform} = brand
#. name.
#: settings_panel.py:1963
msgid "{platform} login failed"
msgstr ""

#. Translators: Login error with the platform's own message. {platform} =
#. brand name, {error} = message from the platform.
#: settings_panel.py:67
msgid "{platform} login failed: {error}"
msgstr ""

#. Translators: Announced when a smart home platform is reachable again after
#. a connection loss. {platform} is Meross/Netatmo/VeSync.
#: scheduler.py:128
msgid "{platform} reconnected"
msgstr ""

#. Translators: Announced when a smart home platform is temporarily
#. unreachable.
#: scheduler.py:133
msgid "{platform} temporarily unreachable"
msgstr ""

#. Translators: Login error for wrong credentials. {platform} = brand name
#. (Meross etc.). The library's own English message is replaced here, since it
#. is not translatable.
#: settings_panel.py:58
msgid "{platform}: email address or password not accepted"
msgstr ""

#. Translators: Announcement after a refused credential check. {reason} = why
#. the platform refused, e.g. "Meross: email address or password not
#. accepted".
#: settings_panel.py:1795
msgid "{reason}. Nothing saved - please enter the credentials again"
msgstr ""

#. Translators: Remaining cooking time of an air fryer, under a minute.
#. {seconds} = seconds.
#: vesync_devices.py:1578
msgid "{seconds} sec"
msgstr ""

#. Translators: Period of the readings. {start}/{end} = date and time.
#: dialog_history.py:427
msgid "{start} to {end}"
msgstr ""

#. Translators: A temperature with its unit, put together with other pieces
#. into one announcement.
#: __init__.py:1722
msgid "{temp}°C"
msgstr ""

#. Translators: Fallback for a history entry of unknown type.
#: history.py:1061
msgid "{time} – {name}: unknown event"
msgstr ""

#. Translators: Success message after login. {total} = number of devices,
#. {detail} = breakdown per platform (e.g. "3 Meross, 1 Netatmo").
#: __init__.py:1008
msgid "{total} devices ready ({detail})"
msgstr ""

#. Translators: Status announcement: gust speed.
#: netatmo_api.py:307
msgid "{value} km/h gusts"
msgstr ""

#. Translators: Status announcement: wind speed.
#: netatmo_api.py:302
msgid "{value} km/h wind"
msgstr ""

#. Translators: Status announcement: rain amount.
#: netatmo_api.py:297
msgid "{value} mm rain"
msgstr ""

#. Translators: Relative humidity in the status announcement.
#: __init__.py:1726 netatmo_api.py:280
msgid "{value}% humidity"
msgstr ""

#. Translators: Current power draw in the status announcement.
#: __init__.py:1745
msgid "{watt} watts"
msgstr ""

#. Translators: Group heading in the history: weekday and date, e.g. "Freitag,
#. 24.07.2026".
#: dialog_history.py:58
msgid "{weekday}, {date}"
msgstr ""
