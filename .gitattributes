# Store text files in the repository with LF, in the working copy according
# to core.autocrlf (so CRLF on Windows).
* text=auto

# NEVER touch the bundled third-party libraries: the *.dist-info/RECORD
# files hold SHA256 checksums of the unpacked wheel files - any line-ending
# conversion would invalidate them.
lib/** -text

# Binary formats explicitly, so no heuristic gets it wrong.
*.pyd binary
*.mo  binary
*.nvda-addon binary
